# RGL website — caching rules (Apache / cPanel / z.com)
#
# HTML should revalidate so visitors pick up new asset ?v= versions.
# CSS/JS/images can be cached longer; change the ?v= query in index.html to bust cache.

<IfModule mod_headers.c>
  # Always re-check HTML after deploy
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Versioned static assets (safe to cache; bump ?v= when content changes)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Optional: disable MultiViews quirks
Options -MultiViews
